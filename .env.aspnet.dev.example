# Copy to .env.aspnet.dev and use the existing local Laravel workspace database.
ConnectionStrings__Workspace="Host=127.0.0.1;Port=5432;Database=todo_inn_laravel_dev;Username=todo_inn_app;Password="
# Optional override. Defaults to ~/.local/share/todo-inn/dev-keys.
AuthPreview__SessionKeyDirectory=
Registration__Enabled=false
Mail__FrontendUrl=http://localhost:5173
Mail__FromAddress=
Mail__FromName="To Do Inn"
Mail__ResendApiKey=
