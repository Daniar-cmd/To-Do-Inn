[Unit]
Description=To Do Inn ASP.NET Core API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=todo-inn
Group=todo-inn
WorkingDirectory=/opt/todo-inn/current/api
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=PublicApi__Enabled=true
Environment=PublicApi__Port=8002
Environment=PublicApi__SessionKeyDirectory=/var/lib/todo-inn/keys
EnvironmentFile=/etc/todo-inn/aspnet.env
ExecStart=/opt/todo-inn/current/api/Workspace.Api
Restart=on-failure
RestartSec=5s
StateDirectory=todo-inn/keys
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
