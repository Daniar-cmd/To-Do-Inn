{
  "name": "to-do-inn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:api": "node --import tsx backend/dev-api.mts",
    "dev:styles": "node --import tsx ./node_modules/gulp/bin/gulp.js --gulpfile gulpfile.ts dev",
    "build": "node --import tsx ./node_modules/gulp/bin/gulp.js --gulpfile gulpfile.ts build && vite build --config vite.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:frontend": "node --import tsx --test tests/js/*.test.mts",
    "test:local": "bash tests/dotnet-local-smoke.sh"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "gulp": "^5.0.1",
    "gulp-sass": "^6.0.1",
    "sass": "^1.106.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
