PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=todo_inn
PG_USER=todo_inn_app
PG_PASSWORD=replace-with-a-local-secret

# Local Laravel app: use .env.laravel and a separate database (npm run dev:api).
# PG_* above is retained only for the legacy fallback; do not overwrite the old .env.
APP_NAME="To Do Inn"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=todo_inn_laravel_dev
DB_USERNAME=todo_inn_app
DB_PASSWORD=replace-with-a-local-secret

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
# Argon2id for new Laravel passwords; existing bcrypt hashes remain readable.
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
LOG_CHANNEL=single
LOG_LEVEL=debug

# Laravel mail via the Resend API (copy these into the ignored .env.laravel locally).
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="To Do Inn"
RESEND_API_KEY=replace-with-a-resend-api-key
