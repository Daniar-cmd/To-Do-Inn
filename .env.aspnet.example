# ASP.NET Core environment settings for an isolated preview.
ConnectionStrings__Workspace=
ASPNETCORE_URLS=http://127.0.0.1:8002
AuthPreview__Enabled=false
# Set true only for an isolated loopback preview served over HTTP.
AuthPreview__AllowLoopbackHttp=false
# Optional absolute path outside the repository for persistent preview sessions. Apply the .NET migration first.
AuthPreview__SessionKeyDirectory=
# Optional fixed test code for an isolated loopback preview. Skips email delivery.
AuthPreview__UseLocalVerificationCode=false
# Local HTTPS staging uses ASPNETCORE_ENVIRONMENT=Production and the Caddy staging config.
PublicApi__Enabled=false
PublicApi__Host=localhost
PublicApi__Port=8002
# Required for PublicApi. Use a separate existing absolute path outside the repository.
PublicApi__SessionKeyDirectory=
Registration__Enabled=false
Mail__FrontendUrl=
Mail__FromAddress=
Mail__FromName="To Do Inn"
Mail__ResendApiKey=
